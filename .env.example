# ==========================================
# Exemplo de Variáveis de Ambiente
# ==========================================

# String de Conexão com o MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.kjp90za.mongodb.net/analiseautomatizadadb?appName=Cluster0

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Kivora Payments API (Processamento M-Pesa e e-Mola)
# Obtenha sua Secret Key no painel da Kivora: https://www.kivorapayments.com
# Use sk_test_... para ambiente de testes ou sk_live_... para produção
KIVORA_SECRET_KEY=sk_test_sua_chave_secreta_aqui
KIVORA_API_URL=https://www.kivorapayments.com

# Google OAuth 2.0 (Autenticação com Conta Google)
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-seu_client_secret_aqui
